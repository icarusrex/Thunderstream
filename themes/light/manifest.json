{
  "manifest_version": 2,
  "name": "Thunderstream Light",
  "version": "0.1.3",
  "description": "Soft neutral surfaces and blue accents for stock Thunderbird. Unverified pre-release.",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderstream-light@local.invalid",
      "strict_min_version": "140.0"
    }
  },
  "theme": {
    "colors": {
      "frame": "#f0f0f0",
      "toolbar": "#f5f5f5",
      "toolbar_text": "#252525",
      "toolbar_top_separator": "#dedede",
      "toolbar_bottom_separator": "#d7d7d7",
      "toolbar_vertical_separator": "#d7d7d7",
      "tab_background_text": "#626262",
      "tab_selected": "#ffffff",
      "tab_text": "#252525",
      "tab_line": "#0a84ff",
      "tab_loading": "#0a84ff",
      "toolbar_field": "#e8e8e8",
      "toolbar_field_text": "#262626",
      "toolbar_field_border": "#d4d4d4",
      "toolbar_field_focus": "#ffffff",
      "toolbar_field_text_focus": "#1f1f1f",
      "toolbar_field_border_focus": "#0a84ff",
      "toolbar_field_highlight": "#0a84ff",
      "toolbar_field_highlight_text": "#ffffff",
      "popup": "#f8f8f8",
      "popup_text": "#1f1f1f",
      "popup_border": "#d5d5d5",
      "popup_highlight": "#0a84ff",
      "popup_highlight_text": "#ffffff",
      "sidebar": "#f2f2f2",
      "sidebar_text": "#3b3b3b",
      "sidebar_border": "#dedede",
      "sidebar_highlight": "rgba(10,132,255,.14)",
      "sidebar_highlight_text": "#1f2937",
      "button_background_hover": "#e5e5e7",
      "button_background_active": "#d2d2d7"
    }
  }
}
